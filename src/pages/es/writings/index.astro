---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Container from '../../../components/Container.astro';
import JournalEntryPreview from '../../../components/JournalEntryPreview.astro';

const entries = (await getCollection('journal', ({ data }) => data.language === 'es' && !data.draft && !['movie', 'book'].includes(data.type)))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Textos — Pabs File" description="Ensayos, ideas, notas técnicas, vida y pensamientos escritos antes de que desaparezcan." lang="es" switchHref="/writings">
	<section class="inner-page">
		<Container>
			<p class="inner-label">vista interior / journal</p>
			<h1 class="inner-title">Textos</h1>
			<p class="inner-deck">Ideas escritas antes de que desaparezcan o antes de convertirme en alguien que ya no está de acuerdo con ellas.</p>
			<div class="preview-grid">
				{entries.map((entry, index) => <JournalEntryPreview {entry} lang="es" featured={index === 0} />)}
			</div>
		</Container>
	</section>
</BaseLayout>
