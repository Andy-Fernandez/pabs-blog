---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Container from '../../../components/Container.astro';
import JournalEntryPreview from '../../../components/JournalEntryPreview.astro';

const entries = (await getCollection('journal', ({ data }) => data.language === 'es' && !data.draft))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Journal — Pabs File" description="Ideas, películas, libros, comida, tecnología, vida y todo lo que se niega a caber en un solo tema." lang="es" switchHref="/journal">
	<Container class="page-hero">
		<span class="eyebrow">un sistema / muchos intereses</span>
		<h1 class="page-title">Journal</h1>
		<p class="page-deck">Ideas, películas, libros, comida, tecnología, vida y cualquier cosa que necesite recordar después.</p>
	</Container>
	<section class="section">
		<Container>
			<div class="trace-grid">
				{entries.map((entry, index) => <JournalEntryPreview {entry} lang="es" featured={index === 0} />)}
			</div>
		</Container>
	</section>
</BaseLayout>
