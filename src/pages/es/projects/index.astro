---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Container from '../../../components/Container.astro';
import ProjectPreview from '../../../components/ProjectPreview.astro';

const entries = (await getCollection('projects', ({ data }) => data.language === 'es' && !data.draft))
	.sort((a, b) => b.data.year - a.data.year || Number(b.data.featured) - Number(a.data.featured));
---

<BaseLayout title="Proyectos — Pabs Life" description="Cosas que construí intencionalmente: las útiles, las experimentales y las que todavía están cambiando." lang="es" switchHref="/projects">
	<section class="inner-page">
		<Container>
			<p class="inner-label">vista interior / proyectos</p>
			<h1 class="inner-title">Proyectos</h1>
			<p class="inner-deck">Cosas que construí intencionalmente. La página final contará sus historias; esta vista solamente establece el lenguaje calmado del archivo.</p>
			<div class="preview-grid">
				{entries.map((entry, index) => <ProjectPreview {entry} lang="es" featured={index === 0} />)}
			</div>
		</Container>
	</section>
</BaseLayout>
