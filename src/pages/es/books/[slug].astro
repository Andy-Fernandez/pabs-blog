---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ContentLayout from '../../../layouts/ContentLayout.astro';
import { formatDate, journalType } from '../../../lib/i18n';

export async function getStaticPaths() {
	const entries = await getCollection('journal', ({ data }) => data.language === 'es' && !data.draft && data.type === 'book');
	return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

interface Props { entry: CollectionEntry<'journal'> }
const { entry } = Astro.props;
const { Content } = await render(entry);
const entries = await getCollection('journal', ({ data }) => data.language === 'en' && !data.draft && data.type === 'book');
const alternate = entries.find((candidate) => candidate.data.translationKey && candidate.data.translationKey === entry.data.translationKey);
const switchHref = alternate ? `/books/${alternate.data.slug}` : '/books';
---

<ContentLayout
	title={entry.data.title}
	description={entry.data.description}
	lang="es"
	{switchHref}
	kind={`${journalType.es.book}${entry.data.author ? ` / ${entry.data.author}` : ''}`}
	dateOrYear={formatDate(entry.data.date, 'es')}
	tags={entry.data.tags}
	backHref="/es/books"
>
	<Content />
</ContentLayout>
