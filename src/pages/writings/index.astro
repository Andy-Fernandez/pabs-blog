---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import JournalEntryPreview from '../../components/JournalEntryPreview.astro';

const entries = (await getCollection('journal', ({ data }) => data.language === 'en' && !data.draft && !['movie', 'book'].includes(data.type)))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Writings — Pabs Life" description="Essays, thoughts, technical notes, life, and ideas written down before they disappear." lang="en" switchHref="/es/writings">
	<section class="inner-page">
		<Container>
			<p class="inner-label">inner-page preview / journal</p>
			<h1 class="inner-title">Writings</h1>
			<p class="inner-deck">Ideas written down before they disappear—or before I become someone who no longer agrees with them.</p>
			<div class="preview-grid">
				{entries.map((entry, index) => <JournalEntryPreview {entry} lang="en" featured={index === 0} />)}
			</div>
		</Container>
	</section>
</BaseLayout>
