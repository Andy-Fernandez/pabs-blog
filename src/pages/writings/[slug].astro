---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import { formatDate, journalType } from '../../lib/i18n';

export async function getStaticPaths() {
	const entries = await getCollection('journal', ({ data }) => data.language === 'en' && !data.draft && !['movie', 'book'].includes(data.type));
	return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

interface Props { entry: CollectionEntry<'journal'> }
const { entry } = Astro.props;
const { Content } = await render(entry);
const entries = await getCollection('journal', ({ data }) => data.language === 'es' && !data.draft);
const alternate = entries.find((candidate) => candidate.data.translationKey && candidate.data.translationKey === entry.data.translationKey);
const switchHref = alternate ? `/es/writings/${alternate.data.slug}` : '/es/writings';
---

<ContentLayout
	title={entry.data.title}
	description={entry.data.description}
	lang="en"
	{switchHref}
	kind={journalType.en[entry.data.type]}
	dateOrYear={formatDate(entry.data.date, 'en')}
	tags={entry.data.tags}
	backHref="/writings"
>
	<Content />
</ContentLayout>
