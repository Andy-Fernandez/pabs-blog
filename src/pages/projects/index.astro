---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import ProjectPreview from '../../components/ProjectPreview.astro';

const entries = (await getCollection('projects', ({ data }) => data.language === 'en' && !data.draft))
	.sort((a, b) => b.data.year - a.data.year || Number(b.data.featured) - Number(a.data.featured));
---

<BaseLayout title="Projects — Pabs File" description="Things I intentionally built, including the useful, the experimental, and the still becoming." lang="en" switchHref="/es/projects">
	<section class="inner-page">
		<Container>
			<p class="inner-label">inner-page preview / projects</p>
			<h1 class="inner-title">Projects</h1>
			<p class="inner-deck">Things I intentionally built. The final page will tell their stories; this preview only establishes the calmer archive language.</p>
			<div class="preview-grid">
				{entries.map((entry, index) => <ProjectPreview {entry} lang="en" featured={index === 0} />)}
			</div>
		</Container>
	</section>
</BaseLayout>
