---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
---

<BaseLayout title="404 — Trace not found" description="This piece of the archive is missing." lang="en" switchHref="/es">
	<Container class="page-hero">
		<span class="eyebrow">error / missing fragment</span>
		<h1 class="page-title">404</h1>
		<p class="page-deck">This trace is missing, unfinished, or never existed. That also feels strangely appropriate.</p>
		<div class="hero-actions"><a class="button-cut" href="/">Return to the archive</a></div>
	</Container>
</BaseLayout>
