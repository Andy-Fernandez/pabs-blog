---
import type { CollectionEntry } from 'astro:content';
import { prefixFor, ui, type Lang } from '../lib/i18n';

interface Props {
	entry: CollectionEntry<'projects'>;
	lang: Lang;
	featured?: boolean;
}

const { entry, lang, featured = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = `${base}${prefixFor(lang)}/projects/${entry.data.slug}`;
---

<article class:list={['preview-card', { featured }]}>
	<p class="preview-meta">{lang === 'es' ? 'proyecto' : 'project'} / {entry.data.status} / {entry.data.year}</p>
	<h3>{entry.data.title}</h3>
	<p>{entry.data.description}</p>
	<a href={href}>{ui[lang].view}<span>→</span></a>
</article>
