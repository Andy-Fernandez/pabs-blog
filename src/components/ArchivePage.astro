---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from './Container.astro';
import { formatDate, journalType, prefixFor, type Lang } from '../lib/i18n';

interface Props {
	lang: Lang;
	journal: CollectionEntry<'journal'>[];
	projects: CollectionEntry<'projects'>[];
}

const { lang, journal, projects } = Astro.props;
const prefix = prefixFor(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const hrefFor = (path: string) => `${base}${prefix}${path}`;

const items = [
	...journal.map((entry) => {
		const section = entry.data.type === 'movie' ? 'movies' : entry.data.type === 'book' ? 'books' : 'writings';
		return {
			timestamp: entry.data.date.valueOf(),
			date: formatDate(entry.data.date, lang),
			kind: journalType[lang][entry.data.type],
			title: entry.data.title,
			href: hrefFor(`/${section}/${entry.data.slug}`),
		};
	}),
	...projects.map((entry) => ({
		timestamp: new Date(`${entry.data.year}-01-01T00:00:00Z`).valueOf(),
		date: String(entry.data.year),
		kind: lang === 'es' ? 'proyecto' : 'project',
		title: entry.data.title,
		href: hrefFor(`/projects/${entry.data.slug}`),
	})),
].sort((a, b) => b.timestamp - a.timestamp);

const copy = lang === 'es' ? {
	title: '2026 — Archivo de Pabs',
	description: 'Una vista cronológica de las huellas publicadas durante 2026.',
	label: 'vista interior / índice cronológico',
	deck: 'Una versión simple del archivo futuro. El contenido es real; esta página todavía no es una prioridad visual.',
} : {
	title: '2026 — Pabs Archive',
	description: 'A chronological view of the traces published during 2026.',
	label: 'inner-page preview / chronological index',
	deck: 'A simple version of the future archive. The content is real; this page is not a visual priority yet.',
};
---

<BaseLayout title={copy.title} description={copy.description} {lang} switchHref={lang === 'es' ? '/2026' : '/es/2026'}>
	<section class="inner-page">
		<Container>
			<p class="inner-label">{copy.label}</p>
			<h1 class="inner-title">2026</h1>
			<p class="inner-deck">{copy.deck}</p>

			<div class="inner-archive-list">
				{items.map((item, index) => (
					<a href={item.href}>
						<span>{String(index + 1).padStart(2, '0')}</span>
						<strong>{item.title}</strong>
						<small>{item.kind} / {item.date}</small>
						<i aria-hidden="true">→</i>
					</a>
				))}
			</div>
		</Container>
	</section>
</BaseLayout>
