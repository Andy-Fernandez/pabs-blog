---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from './Container.astro';
import { formatDate, journalType, prefixFor, type Lang } from '../lib/i18n';

interface Props {
	lang: Lang;
	journal: CollectionEntry<'journal'>[];
	projects: CollectionEntry<'projects'>[];
}

const { lang, journal, projects } = Astro.props;
const prefix = prefixFor(lang);

const items = [
	...journal.map((entry) => ({
		timestamp: entry.data.date.valueOf(),
		date: formatDate(entry.data.date, lang),
		kind: journalType[lang][entry.data.type],
		title: entry.data.title,
		href: `${prefix}/writings/${entry.data.slug}`,
	})),
	...projects.map((entry) => ({
		timestamp: new Date(`${entry.data.year}-01-01T00:00:00`).valueOf(),
		date: String(entry.data.year),
		kind: lang === 'es' ? 'proyecto' : 'project',
		title: entry.data.title,
		href: `${prefix}/projects/${entry.data.slug}`,
	})),
].sort((a, b) => b.timestamp - a.timestamp);

const copy = lang === 'es' ? {
	title: '2026 — Archivo de Pabs',
	description: 'Las huellas publicadas por Pablo durante 2026.',
	eyebrow: 'caja de memoria / año uno',
	deck: 'Lo que estaba construyendo, pensando y aprendiendo. Una versión anterior de mí, guardada sin fingir que ya estaba terminada.',
} : {
	title: '2026 — Pabs Archive',
	description: 'The traces Pablo published during 2026.',
	eyebrow: 'memory box / year one',
	deck: 'What I was building, thinking, and learning. An earlier version of me, kept without pretending it was already finished.',
};
---

<BaseLayout title={copy.title} description={copy.description} {lang} switchHref={lang === 'es' ? '/2026' : '/es/2026'}>
	<Container class="page-hero">
		<span class="eyebrow">{copy.eyebrow}</span>
		<h1 class="page-title">2026</h1>
		<p class="page-deck">{copy.deck}</p>
	</Container>
	<section class="section">
		<Container>
			<div class="archive-list">
				{items.map((item) => (
					<a class="archive-row" href={item.href}>
						<time class="archive-date">{item.date}</time>
						<span class="archive-title">{item.title}</span>
						<span class="archive-kind">{item.kind} →</span>
					</a>
				))}
			</div>
		</Container>
	</section>
</BaseLayout>
