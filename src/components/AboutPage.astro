---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from './Container.astro';
import type { Lang } from '../lib/i18n';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const copy = lang === 'es' ? {
	title: 'Sobre mí — Pabs File',
	description: 'Una vista previa de la futura página personal de Pablo.',
	label: 'vista interior / todavía no construida',
	heading: 'Sobre este humano',
	deck: 'Esta página llegará después de la home. Por ahora muestra el tono: más calmado, personal y legible.',
	status: 'Pendiente de una conversación real con Pablo',
	traces: [
		['Ahora', 'Crear, observar, sentir y aprender sin fingir una identidad terminada.'],
		['Me importa', 'La comunidad, el cuidado, las preguntas difíciles y las cosas hechas con atención.'],
		['Este lugar', 'Un hogar para proyectos, películas, libros, comida, teatro y versiones anteriores de mí.'],
	],
} : {
	title: 'About — Pabs File',
	description: 'A preview of Pablo’s future personal page.',
	label: 'inner-page preview / not built yet',
	heading: 'About this human',
	deck: 'This page comes after the home. For now it shows the intended tone: calmer, personal, and readable.',
	status: 'Waiting for a real conversation with Pablo',
	traces: [
		['Right now', 'Creating, observing, feeling, and learning without pretending to be finished.'],
		['I care about', 'Community, care, difficult questions, and things made with attention.'],
		['This place', 'A home for projects, films, books, food, theatre, and earlier versions of me.'],
	],
};
---

<BaseLayout title={copy.title} description={copy.description} {lang} switchHref={lang === 'es' ? '/about' : '/es/about'}>
	<section class="inner-page">
		<Container>
			<p class="inner-label">{copy.label}</p>
			<h1 class="inner-title">{copy.heading}</h1>
			<p class="inner-deck">{copy.deck}</p>
			<p class="preview-status"><span aria-hidden="true"></span>{copy.status}</p>

			<div class="about-traces">
				{copy.traces.map(([label, text], index) => (
					<article>
						<span>{String(index + 1).padStart(2, '0')} / {label}</span>
						<p>{text}</p>
					</article>
				))}
			</div>
		</Container>
	</section>
</BaseLayout>
