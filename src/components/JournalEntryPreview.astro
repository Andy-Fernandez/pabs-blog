---
import type { CollectionEntry } from 'astro:content';
import { formatDate, journalType, prefixFor, ui, type Lang } from '../lib/i18n';

interface Props {
	entry: CollectionEntry<'journal'>;
	lang: Lang;
	featured?: boolean;
}

const { entry, lang, featured = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = `${base}${prefixFor(lang)}/writings/${entry.data.slug}`;
---

<article class:list={['preview-card', { featured }]}>
	<p class="preview-meta">{entry.data.label ?? journalType[lang][entry.data.type]} / {formatDate(entry.data.date, lang)}</p>
	<h3>{entry.data.title}</h3>
	<p>{entry.data.description}</p>
	<a href={href}>{ui[lang].read}<span>→</span></a>
</article>
