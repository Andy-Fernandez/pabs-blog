---
import Container from './Container.astro';
import { prefixFor, type Lang } from '../lib/i18n';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const aboutHref = `${base}${prefixFor(lang)}/about`;
---

<footer class="site-footer">
	<Container class="footer-inner">
		<p class="footer-mark">Pabs Life / 2026</p>
		<p class="footer-statement">
			{lang === 'es'
				? 'Un archivo personal hecho a mano en La Paz y en otros lugares.'
				: 'A personal archive made by hand in La Paz and elsewhere.'}
		</p>
		<a href={aboutHref}>{lang === 'es' ? 'Seguir el rastro →' : 'Follow the trace →'}</a>
	</Container>
</footer>
