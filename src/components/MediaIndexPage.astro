---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from './Container.astro';
import { formatDate, prefixFor, type Lang } from '../lib/i18n';

interface Props {
	lang: Lang;
	type: 'movie' | 'book';
	entries: CollectionEntry<'journal'>[];
}

const { lang, type, entries } = Astro.props;
const prefix = prefixFor(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const section = type === 'movie' ? 'movies' : 'books';
const isMovie = type === 'movie';
const copy = lang === 'es'
	? {
		title: isMovie ? 'Películas' : 'Libros',
		description: isMovie
			? 'Películas que se quedaron conmigo y opiniones que probablemente cambiarán.'
			: 'Ideas subrayadas, desacuerdos y libros que cambiaron algo en mi forma de mirar.',
		label: 'vista interior / todavía en construcción',
		empty: 'La primera entrada todavía está esperando.',
	}
	: {
		title: isMovie ? 'Movies' : 'Books',
		description: isMovie
			? 'Films that stayed with me and opinions that will probably change.'
			: 'Underlined ideas, disagreements, and books that changed the way I look.',
		label: 'inner-page preview / still under construction',
		empty: 'The first entry is still waiting.',
	};
---

<BaseLayout
	title={`${copy.title} — Pabs Life`}
	description={copy.description}
	{lang}
	switchHref={`${lang === 'es' ? '' : '/es'}/${section}`}
>
	<section class="inner-page">
		<Container>
			<p class="inner-label">{copy.label}</p>
			<h1 class="inner-title">{copy.title}</h1>
			<p class="inner-deck">{copy.description}</p>

			{entries.length === 0 ? <p class="empty-state">{copy.empty}</p> : (
				<div class="inner-archive-list">
					{entries.map((entry, index) => (
						<a href={`${base}${prefix}/${section}/${entry.data.slug}`}>
							<span>{String(index + 1).padStart(2, '0')}</span>
							<strong>{entry.data.title}</strong>
							<small>{entry.data.subject ?? type} / {formatDate(entry.data.date, lang)}</small>
							<i aria-hidden="true">→</i>
						</a>
					))}
				</div>
			)}
		</Container>
	</section>
</BaseLayout>
