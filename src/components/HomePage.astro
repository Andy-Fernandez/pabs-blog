---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from './Container.astro';
import JournalEntryPreview from './JournalEntryPreview.astro';
import ProjectPreview from './ProjectPreview.astro';
import LatelyItem from './LatelyItem.astro';
import { prefixFor, type Lang } from '../lib/i18n';

interface Props {
	lang: Lang;
	projects: CollectionEntry<'projects'>[];
	journal: CollectionEntry<'journal'>[];
}

const { lang, projects, journal } = Astro.props;
const prefix = prefixFor(lang);

const copy = lang === 'es' ? {
	title: 'Pabs File — Un archivo humano en progreso',
	description: 'Un archivo personal y creativo sobre las cosas que Pablo construye, piensa, aprende, observa y hace.',
	eyebrow: 'archivo personal / edición 001 / 2026',
	titleA: 'Sigo',
	titleB: 'cambiando.',
	intro: 'Hola, soy Pabs. Me encanta crear, sentir y observar. Este es el lugar donde guardo las huellas de la persona en la que me voy convirtiendo.',
	openArchive: 'Abrir el archivo 2026',
	about: 'Sobre este humano',
	note: 'NO ES UN PORTAFOLIO / NO TIENE UN SOLO TEMA / NO ESTÁ TERMINADO',
	ticket: 'LA PAZ / AGO 2026 / ADMITE A UNA PERSONA CURIOSA',
	stamp: 'HECHO POR UNA PERSONA',
	projectsTitle: 'Cosas que construyo',
	projectsKicker: 'proyectos / intentos / accidentes útiles',
	writingsTitle: 'Último ruido',
	writingsKicker: 'notas / ensayos / devlogs',
	writingsScrap: 'ESCRIBIR PARA NO OLVIDAR EN QUÉ ESTABA PENSANDO',
	moviesTitle: 'Películas',
	moviesKicker: 'películas sobre las que tengo opiniones',
	movieFeatureLabel: 'movie log / próximo rastro',
	movieFeatureTitle: 'Una película en la que no puedo dejar de pensar',
	movieFeatureBody: 'Qué funcionó, qué me molestó, la imagen que se quedó conmigo y la pregunta que la película se negó a responder.',
	movieQuickLabel: 'toma rápida / sin voz de crítico',
	movieQuickTitle: 'Hermosa. Confusa. Valió la pena.',
	movieQuickBody: '“Entendí quizá el 70% y estoy eligiendo creer que eso era parte de la experiencia.”',
	movieTicket: 'FUNCIÓN ÚNICA / FILA ? / ASIENTO ? / GUARDAR DESPUÉS DE VER',
	booksTitle: 'Libros',
	booksKicker: 'fragmentos / márgenes / ideas robadas',
	bookFeatureLabel: 'leyendo ahora / lápiz obligatorio',
	bookFeatureTitle: 'Subrayarlo todo.',
	bookFeatureBody: 'Un registro vivo puede guardar citas, desacuerdos, preguntas, conexiones extrañas y las ideas que todavía no sé explicar.',
	bookNoteLabel: 'nota al margen',
	bookNoteTitle: 'La idea que me robé de este libro',
	bookNoteBody: 'No todos los libros necesitan una reseña. A veces una sola idea cambia la forma de mirar algo.',
	latelyTitle: 'Últimamente',
	latelyKicker: 'una foto borrosa del presente',
	lately: [
		['Mirando', 'Cómo se comporta la memoria en las películas'],
		['Leyendo', 'Notas sobre creatividad e identidad'],
		['Construyendo', 'Este archivo vivo'],
		['Cocinando', 'Despacio, con errores y sin receta fija'],
		['Aprendiendo', 'A publicar antes de sentir que todo está listo'],
	],
	manifesto: 'La conexión entre todo lo que hay aquí soy yo.',
	manifestoAside: 'No documento solamente lo que hice. Documento el proceso de convertirme en alguien: lo terminado, lo extraño, lo cotidiano, lo que falló y lo que quizá mañana ya no pienso igual.',
} : {
	title: 'Pabs File — A human archive in progress',
	description: 'A personal, creative archive of the things Pablo builds, thinks, learns, observes, and makes.',
	eyebrow: 'personal archive / issue 001 / 2026',
	titleA: 'Still',
	titleB: 'becoming.',
	intro: 'Hi, this is me: Pabs. I love to create, feel, and observe. This is where I keep the traces of the person I am becoming.',
	openArchive: 'Open the 2026 archive',
	about: 'About this human',
	note: 'NOT A PORTFOLIO / NOT ONE TOPIC / NOT FINISHED',
	ticket: 'LA PAZ / AUG 2026 / ADMIT ONE CURIOUS PERSON',
	stamp: 'MADE BY A PERSON',
	projectsTitle: 'Things I build',
	projectsKicker: 'projects / attempts / useful accidents',
	writingsTitle: 'Latest noise',
	writingsKicker: 'notes / essays / devlogs',
	writingsScrap: 'WRITING SO I DON’T FORGET WHAT I WAS THINKING',
	moviesTitle: 'Movies',
	moviesKicker: 'films I have opinions about',
	movieFeatureLabel: 'movie log / next trace',
	movieFeatureTitle: 'A movie I can’t stop thinking about',
	movieFeatureBody: 'What worked, what annoyed me, the image that stayed, and the question the movie refused to answer.',
	movieQuickLabel: 'quick take / no critic voice',
	movieQuickTitle: 'Beautiful. Confusing. Worth it.',
	movieQuickBody: '“I understood maybe 70% of it and I’m choosing to believe that was part of the experience.”',
	movieTicket: 'ONE SCREENING / ROW ? / SEAT ? / KEEP AFTER WATCHING',
	booksTitle: 'Books',
	booksKicker: 'fragments / margins / stolen ideas',
	bookFeatureLabel: 'currently reading / pencil required',
	bookFeatureTitle: 'Underline everything.',
	bookFeatureBody: 'A living reading log can hold quotes, disagreements, questions, strange connections, and ideas I still cannot explain.',
	bookNoteLabel: 'margin note',
	bookNoteTitle: 'The idea I stole from this book',
	bookNoteBody: 'Not every book needs a review. Sometimes a single idea changes the way I look at something.',
	latelyTitle: 'Lately',
	latelyKicker: 'a blurry picture of right now',
	lately: [
		['Watching', 'How memory behaves in films'],
		['Reading', 'Notes on creativity and identity'],
		['Building', 'This living archive'],
		['Cooking', 'Slowly, messily, without a fixed recipe'],
		['Learning', 'To publish before everything feels finished'],
	],
	manifesto: 'The connection between everything here is me.',
	manifestoAside: 'I am not only documenting what I did. I am documenting the process of becoming someone: the finished parts, the strange parts, the ordinary parts, what failed, and what I might not believe tomorrow.',
};
---

<BaseLayout title={copy.title} description={copy.description} {lang} switchHref={lang === 'en' ? '/es' : '/'}>
	<section class="section">
		<Container class="hero">
			<div>
				<span class="eyebrow">{copy.eyebrow}</span>
				<h1 class="hero-title"><span>{copy.titleA}</span><span>{copy.titleB}</span></h1>
				<p class="hero-copy">{copy.intro}</p>
				<div class="hero-actions">
					<a class="button-cut" href={`${prefix}/2026`}>{copy.openArchive}</a>
					<a class="button-cut secondary" href={`${prefix}/about`}>{copy.about}</a>
				</div>
			</div>

			<div class="archive-collage" aria-hidden="true">
				<div class="tape top"></div>
				<div class="collage-sheet"></div>
				<div class="collage-note">{copy.note}</div>
				<div class="collage-ticket">{copy.ticket}</div>
				<div class="collage-stamp">{copy.stamp}</div>
			</div>
		</Container>
	</section>

	<section class="section">
		<Container>
			<div class="section-heading">
				<h2>{copy.projectsTitle}</h2>
				<span class="section-kicker">{copy.projectsKicker}</span>
			</div>
			<div class="project-grid">
				{projects.length > 0 ? projects.slice(0, 2).map((entry, index) => <ProjectPreview {entry} {lang} featured={index === 0} />) : (
					<p class="empty-note">{lang === 'es' ? 'Este espacio está esperando su primer proyecto.' : 'This space is waiting for its first project.'}</p>
				)}
			</div>
		</Container>
	</section>

	<section class="section writings-section" id="writings">
		<Container>
			<div class="section-heading">
				<h2>{copy.writingsTitle}</h2>
				<span class="section-kicker">{copy.writingsKicker}</span>
			</div>
			<div class="writings-desk">
				<div class="writing-scrap" aria-hidden="true">{copy.writingsScrap}</div>
				<div class="trace-grid">
				{journal.filter((entry) => !['movie', 'book'].includes(entry.data.type)).length > 0 ? journal.filter((entry) => !['movie', 'book'].includes(entry.data.type)).slice(0, 4).map((entry, index) => <JournalEntryPreview {entry} {lang} featured={index === 0} />) : (
					<p class="empty-note">{lang === 'es' ? 'La primera huella todavía se está escribiendo.' : 'The first trace is still being written.'}</p>
				)}
				</div>
			</div>
		</Container>
	</section>

	<section class="section movies-section" id="movies">
		<Container>
			<div class="section-heading movie-heading">
				<h2>{copy.moviesTitle}</h2>
				<span class="section-kicker">{copy.moviesKicker}</span>
			</div>
			<div class="movie-desk">
				<div class="movie-ticket" aria-hidden="true">{copy.movieTicket}</div>
				<article class="movie-note movie-feature">
					<span class="label">{copy.movieFeatureLabel}</span>
					<h3>{copy.movieFeatureTitle}</h3>
					<p>{copy.movieFeatureBody}</p>
					<div class="rating" aria-label="four out of five">★★★★☆ <small>4/5</small></div>
				</article>
				<article class="movie-note movie-quick">
					<span class="label">{copy.movieQuickLabel}</span>
					<h3>{copy.movieQuickTitle}</h3>
					<p>{copy.movieQuickBody}</p>
					<div class="rating" aria-label="three and a half out of five">★★★½</div>
				</article>
				<div class="movie-stamp" aria-hidden="true">WATCH / FEEL / ARGUE / REWATCH</div>
			</div>
		</Container>
	</section>

	<section class="section books-section" id="books">
		<Container>
			<div class="section-heading">
				<h2>{copy.booksTitle}</h2>
				<span class="section-kicker">{copy.booksKicker}</span>
			</div>
			<div class="book-desk">
				<article class="book-scrap book-feature">
					<span class="label">{copy.bookFeatureLabel}</span>
					<h3>{copy.bookFeatureTitle}</h3>
					<p>{copy.bookFeatureBody}</p>
					<div class="pencil-line" aria-hidden="true"></div>
				</article>
				<article class="book-scrap book-margin">
					<span class="label">{copy.bookNoteLabel}</span>
					<h3>{copy.bookNoteTitle}</h3>
					<p>{copy.bookNoteBody}</p>
				</article>
				<div class="book-spine" aria-hidden="true">READ / MARK / FOLD / RETURN</div>
			</div>
		</Container>
	</section>

	<section class="section">
		<Container>
			<div class="section-heading">
				<h2>{copy.latelyTitle}</h2>
				<span class="section-kicker">{copy.latelyKicker}</span>
			</div>
			<div class="lately-grid">
				{copy.lately.map(([label, text], index) => <LatelyItem number={String(index + 1).padStart(2, '0')} {label} {text} />)}
			</div>
		</Container>
	</section>

	<section class="section manifesto-section">
		<Container>
			<p class="manifesto-line"><mark>{copy.manifesto}</mark></p>
			<p class="manifesto-aside">{copy.manifestoAside}</p>
		</Container>
	</section>
</BaseLayout>
