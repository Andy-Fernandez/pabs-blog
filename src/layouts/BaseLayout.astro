---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import type { Lang } from '../lib/i18n';

interface Props {
	title: string;
	description: string;
	lang?: Lang;
	switchHref?: string;
	image?: string;
}

const {
	title,
	description,
	lang = 'en',
	switchHref = lang === 'en' ? '/es' : '/',
	image,
} = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const manifestHref = `${base}/manifest.webmanifest`;
const serviceWorkerUrl = `${base}/sw.js`;
const serviceWorkerScope = `${base}/`;
const pwaEnabled = import.meta.env.PROD;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="theme-color" content="#f7f7f5" />
		<meta name="application-name" content="Pabs File" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="default" />
		<meta name="apple-mobile-web-app-title" content="Pabs File" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		{canonical && <link rel="canonical" href={canonical} />}
		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
		<link rel="icon" href={`${base}/favicon.ico`} />
		<link rel="apple-touch-icon" href={`${base}/icons/apple-touch-icon.png`} />
		<link rel="manifest" href={manifestHref} />
		<title>{title}</title>
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonical && <meta property="og:url" content={canonical} />}
		{image && canonical && <meta property="og:image" content={new URL(image, canonical)} />}
		<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
		{pwaEnabled && (
			<script is:inline define:vars={{ serviceWorkerUrl, serviceWorkerScope }}>
				if ('serviceWorker' in navigator) {
					window.addEventListener('load', () => {
						navigator.serviceWorker.register(serviceWorkerUrl, { scope: serviceWorkerScope });
					});
				}
			</script>
		)}
	</head>
	<body>
		<div class="app-shell">
			<Header lang={lang} switchHref={switchHref} />
			<main id="main" class="site-main">
				<slot />
			</main>
			<Footer lang={lang} />
		</div>
	</body>
</html>
