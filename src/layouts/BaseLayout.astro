---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import type { Lang } from '../lib/i18n';

interface Props {
	title: string;
	description: string;
	lang?: Lang;
	switchHref?: string;
	image?: string;
}

const {
	title,
	description,
	lang = 'en',
	switchHref = lang === 'en' ? '/es' : '/',
	image,
} = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="theme-color" content="#000000" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		{canonical && <link rel="canonical" href={canonical} />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>{title}</title>
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonical && <meta property="og:url" content={canonical} />}
		{image && canonical && <meta property="og:image" content={new URL(image, canonical)} />}
		<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
	</head>
	<body>
		<Header lang={lang} switchHref={switchHref} />
		<main id="main" class="site-main">
			<slot />
		</main>
		<Footer lang={lang} />
	</body>
</html>
