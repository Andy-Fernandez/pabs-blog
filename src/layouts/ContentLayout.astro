---
import BaseLayout from './BaseLayout.astro';
import Container from '../components/Container.astro';
import { ui, type Lang } from '../lib/i18n';

interface Props {
	title: string;
	description: string;
	lang: Lang;
	switchHref: string;
	kind: string;
	dateOrYear: string;
	tags?: string[];
	backHref: string;
}

const { title, description, lang, switchHref, kind, dateOrYear, tags = [], backHref } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const back = backHref.startsWith(base) ? backHref : `${base}${backHref}`;
---

<BaseLayout title={`${title} — Pabs Life`} description={description} {lang} {switchHref}>
	<article class="article-preview">
		<Container class="article-header">
			<p class="inner-label">{lang === 'es' ? 'vista de lectura / diseño provisional' : 'reading view / provisional design'}</p>
			<p class="article-meta">{kind} / {dateOrYear}</p>
			<h1>{title}</h1>
			<p class="article-deck">{description}</p>
			{tags.length > 0 && (
				<div class="tag-list" aria-label={lang === 'es' ? 'Etiquetas' : 'Tags'}>
					{tags.map((tag) => <span>{tag}</span>)}
				</div>
			)}
		</Container>

		<div class="article-body">
			<Container>
				<div class="prose">
					<slot />
					<a class="back-link" href={back}>← {ui[lang].back}</a>
				</div>
			</Container>
		</div>
	</article>
</BaseLayout>
